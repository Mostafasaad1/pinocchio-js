{
  "name": "pinocchio-js",
  "version": "1.4.0",
  "description": "High-performance WebAssembly bindings for the Pinocchio rigid body dynamics library",
  "keywords": [
    "pinocchio",
    "wasm",
    "webassembly",
    "robotics",
    "dynamics",
    "kinematics",
    "rigid-body-dynamics",
    "physics-engine"
  ],
  "main": "build/pinocchio.js",
  "types": "src/pinocchio.d.ts",
  "files": [
    "build/pinocchio.js",
    "build/pinocchio.wasm",
    "src/pinocchio.d.ts",
    "src/urdf-parser.d.ts",
    "src/urdf-parser.mjs",
    "src/urdf-parser.js",
    "src/collision-checker.d.ts",
    "src/collision-checker.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File ./build.ps1",
    "test": "node tests/runner.js",
    "test:smoke": "node tests/smoke_test.js",
    "test:types": "tsc --project tests/typescript/tsconfig.json --noEmit"
  },
  "dependencies": {
    "xmldom": "^0.6.0"
  },
  "type": "commonjs",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostafasaad1/pinocchio-js.git"
  },
  "author": "Mostafa Saad",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/Mostafasaad1/pinocchio-js/issues"
  },
  "homepage": "https://github.com/Mostafasaad1/pinocchio-js#readme"
}
